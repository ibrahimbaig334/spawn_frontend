# Spawn API (NestJS) base URL — includes the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WS broadcaster (pg LISTEN -> /ws tick/bar streams). One URL, pool routed via ?pool=…
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Active chain. 8453 = Base mainnet, 84532 = Base Sepolia.
NEXT_PUBLIC_CHAIN_ID=8453

# JSON-RPC endpoint for direct on-chain reads/writes (quotes come from the API).
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# Swap router for the active chain (SpawnSwapRouter `swapRouter` in
# deployments/<chainId>.json). Empty disables on-chain trading in the UI.
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=

# Block explorer links.
NEXT_PUBLIC_EXPLORER_BASE_URL=https://basescan.org

# IPFS gateway used to display ipfs:// images (uploads go through the
# backend POST /tokens/images, which pins server-side — no browser keys).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
